{
  "name": "lanbeam",
  "version": "1.0.0",
  "description": "LANBeam — Record-breaking zero-config LAN file transfer. Electron + Rust (napi-rs) + QUIC + BLAKE3 Merkle + zstd + mDNS.",
  "main": "dist/main/index.js",
  "author": "LANBeam",
  "license": "MIT",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.js",
    "build:renderer": "node scripts/copy-renderer.js",
    "build:phone": "node scripts/copy-phone.js",
    "build": "npm run build:ts && npm run build:native && npm run build:renderer && npm run build:phone",
    "watch:ts": "tsc -p tsconfig.json --watch",
    "dev": "npm run build:ts && npm run build:renderer && npm run build:phone && electron .",
    "start": "npm run build:ts && npm run build:renderer && npm run build:phone && electron .",
    "bench": "npm run build:ts && electron . --benchmark",
    "dist": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:publish": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "napi": {
    "name": "lanbeam-core",
    "triples": {
      "defaults": false
    }
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.lanbeam.app",
    "productName": "LANBeam",
    "copyright": "© 2024 LANBeam. All rights reserved.",
    "publish": {
      "provider": "github",
      "owner": "AnonymousV73X",
      "repo": "LAN-FILE-TRANSFER-LANBEAM",
      "releaseType": "release"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!dist/release/**",
      "!**/*.map",
      "!**/native/**"
    ],
    "extraResources": [
      {
        "from": "assets/tray.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LANBeam",
      "perMachine": false,
      "differentialPackage": true
    }
  }
}
